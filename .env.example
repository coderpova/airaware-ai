# ==============================================================================
# AirAware AI — Environment Variables Configuration Template
# ==============================================================================
# Note: Core AirAware AI functionality runs 100% locally and without paid API keys.
# Open-Meteo Air Quality & Geocoding APIs are free, public, and do not require keys.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Optional: Next.js Port (Default 3000)
PORT=3000

# Optional: External LLM Integration (Fallback only; core engine is deterministic)
# NEXT_PUBLIC_GEMINI_API_KEY=
